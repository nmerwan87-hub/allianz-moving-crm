# =====================================================
# Bivro Environment Variables
# Copy this file to .env.local and fill in all values.
# All variables without [optional] are required.
# Missing required variables will throw at startup.
# =====================================================

# --- Supabase ---
# Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS; NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection string used by drizzle-kit migrations
SUPABASE_DB_URL=

# JWT signing secret for custom token validation
SUPABASE_JWT_SECRET=

# --- Application ---
# Public URL of the company portal (e.g. https://app.bivro.io)
NEXT_PUBLIC_APP_URL=

# Secret for customer portal links (/p/...), min. 32 characters: openssl rand -base64 48
# Required in production. Changing it invalidates every link already sent.
PORTAL_TOKEN_SECRET=

# Public URL of the platform admin portal (e.g. https://admin.bivro.io)
NEXT_PUBLIC_ADMIN_URL=

# Shared secret for authenticating Vercel Cron requests
# Each cron handler verifies: Authorization: Bearer {CRON_SECRET}
CRON_SECRET=

# --- AI ---
# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=

# --- Email (Resend) ---
# Resend API key — server only
RESEND_API_KEY=
# Sender domain verified in Resend (DNS), e.g. mail.your-domain.ch
EMAIL_SENDER_DOMAIN=

# Svix signing secret for Resend webhook verification
RESEND_WEBHOOK_SECRET=

# --- PDF rendering ---
# Managed Chrome for PDFs in production (wss://<region>.browserless.io?token=..., pick a European region)
# Locally Google Chrome is used (or CHROME_EXECUTABLE_PATH).
BROWSERLESS_WS_ENDPOINT=

# --- Payments (Stripe) ---
# Stripe secret key — server only
STRIPE_SECRET_KEY=

# Stripe publishable key — safe to expose to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe webhook endpoint signing secret
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — server only
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_STARTER_ANNUAL=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_PRICE_ID_BUSINESS_ANNUAL=

# --- Monitoring (Sentry) ---
# Sentry DSN — used on both client and server
SENTRY_DSN=

# [optional] CI only — Sentry organization slug for source map upload
SENTRY_ORG=

# [optional] CI only — Sentry project slug
SENTRY_PROJECT=

# [optional] CI only — Sentry auth token for source map upload during build
SENTRY_AUTH_TOKEN=

# --- Platform Admin ---
# Google OAuth client ID (restricted to @bivro.io Workspace domain)
PLATFORM_GOOGLE_CLIENT_ID=

# Google OAuth client secret
PLATFORM_GOOGLE_CLIENT_SECRET=

# Platform admin session signing secret
PLATFORM_SESSION_SECRET=
